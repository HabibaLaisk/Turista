{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Turista (MinGW gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/vscode-mingw-debug/appTurista.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build/vscode-mingw-debug",
      "environment": [
        {
          "name": "PATH",
          "value": "C:/Qt/6.11.1/mingw_64/bin;C:/Qt/Tools/mingw1310_64/bin;${env:PATH}"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/Qt/Tools/mingw1310_64/bin/gdb.exe"
    }
  ]
}
